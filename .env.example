# Copie para .env.local e ajuste. Variáveis VITE_* vão para o bundle do
# navegador — NUNCA coloque segredo real aqui.
#
# As chaves de LiveKit, Deepgram e Resend NÃO ficam em arquivo de ambiente:
# são coletadas no /onboarding e guardadas no Supabase Vault, acessíveis
# apenas por edge functions. Veja .lovable/plan.md.

VITE_SUPABASE_PROJECT_ID="seu-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_URL="https://seu-project-id.supabase.co"
